# Experimental, manual-start-only example for the qualified test host.
# Review paths and device nodes before installation on any other machine.
[Unit]
Description=Experimental HPE Gen9 GPU OCSD Temperature Publisher
After=local-fs.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=/opt/gen9-t4-ocsd
ExecStart=/usr/bin/python3 /opt/gen9-t4-ocsd/gen9_t4_ocsd.py
Restart=on-failure
RestartSec=5
WatchdogSec=20
TimeoutStartSec=300
TimeoutStopSec=150
User=root
Group=root
UMask=0077
RuntimeDirectory=gen9-t4-ocsd
RuntimeDirectoryMode=0700
StateDirectory=gen9-t4-ocsd
StateDirectoryMode=0700
DevicePolicy=closed
DeviceAllow=/dev/mem rw
DeviceAllow=/dev/ipmi0 rw
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
ReadWritePaths=/run/gen9-t4-ocsd /var/lib/gen9-t4-ocsd

# Intentionally no EnvironmentFile, workload unit, ExecStop helper,
# container/VM target, or [Install] section. Start manually only.
